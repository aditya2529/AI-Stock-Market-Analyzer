[Unit]
Description=NSE Intraday Trading Engine
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/app
ExecStart=/bin/bash -c '/usr/bin/python3 /home/opc/app/main.py intraday >> /home/opc/logs/intraday.log 2>&1'
Restart=on-failure
RestartSec=30

# Hard memory cap — engine gets killed before OOM-killer hits sshd
MemoryMax=700M
MemoryHigh=600M

# Environment
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/opc/app/.env

[Install]
WantedBy=multi-user.target
