# .env.example — template for .env (DO NOT commit .env)
#
# Copy this file to .env and fill in values. The .env file is gitignored.
# Real credentials must never appear in this template or in commits.

# ── P42: Live trading demo path ─────────────────────────────────────────────
# Master kill switch. Default OFF. Set to exactly "true" to enable any
# live API call. Anything else (false, "True", "yes", "", whitespace,
# missing) keeps the live path disabled. Read on EVERY call via
# dotenv_values so a mid-session flip takes effect immediately.
LIVE_TRADING=false

# Which Upstox key set to use. Must be exactly "sandbox" or "prod".
# This selects which of the two credential sets below is loaded — there
# is no manual swap of API_KEY values. Sandbox keys route the SAME
# https://api.upstox.com/v2 URL to the simulator (per Upstox 2026-05-24
# addendum); URL is constant, key identity decides simulation.
UPSTOX_ENV=sandbox

# Prod credentials (real money path). PROD_ACCESS_TOKEN expires daily at
# ~03:30 IST. Re-login at ~09:00 IST on demo day:
#   1. https://api.upstox.com/v2/login/authorization/dialog?...
#   2. complete OAuth
#   3. paste resulting access_token here
#   4. restart any live CLI session (process must re-read .env)
UPSTOX_PROD_API_KEY=
UPSTOX_PROD_API_SECRET=
UPSTOX_PROD_ACCESS_TOKEN=

# Sandbox credentials (simulator). Same daily-token semantics, but the
# simulator allows order placement without real money risk. Use these
# for the integration test before any live demo run.
UPSTOX_SANDBOX_API_KEY=
UPSTOX_SANDBOX_API_SECRET=
UPSTOX_SANDBOX_ACCESS_TOKEN=

# OAuth redirect URI registered with both Upstox apps. Default value
# below assumes the dashboard is running on localhost:8000.
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/upstox/callback

# ── Other env vars used by the project ──────────────────────────────────────
# This template focuses on P42. The paper engine + alert system rely on
# additional keys documented in CLAUDE.md (TELEGRAM_BOT_TOKEN,
# TELEGRAM_CHAT_ID, EMAIL_USERNAME, EMAIL_PASSWORD, DATA_ADAPTER, etc.).
# Add those to your .env using the same KEY=value format.
